# HRM configuration variable names. Placeholders only - never commit real values.
# Environment variables override appsettings.json. On Windows, prefer `dotnet user-secrets`
# for anything secret.

# ---------------------------------------------------------------- database
ConnectionStrings__DefaultConnection=Server=(localdb)\MSSQLLocalDB;Database=HRM;Trusted_Connection=True;TrustServerCertificate=True
# SqlServer (default) or Sqlite for a machine without SQL Server.
Database__Provider=SqlServer

# ---------------------------------------------------------------- authentication
# Required. At least 32 characters, unique per environment. The app refuses to start without it.
Jwt__Secret=replace-with-a-long-random-secret-at-least-32-characters
Jwt__Issuer=HRM.Server
Jwt__Audience=HRM.Client
Jwt__AccessTokenMinutes=30
Jwt__RefreshTokenDays=14

# ---------------------------------------------------------------- first run
InitialAdmin__Email=admin@hrm.local
InitialAdmin__UserName=admin
# Required on first start only, before any user exists.
InitialAdmin__Password=set-a-unique-initial-admin-password
# Seeds demo employees and sample data. Local evaluation only.
InitialAdmin__SeedDemoData=false

# ---------------------------------------------------------------- email
# false writes .eml files to the pickup directory instead of sending.
Smtp__Enabled=false
Smtp__Host=smtp.example.com
Smtp__Port=587
Smtp__UseStartTls=true
Smtp__Username=
Smtp__Password=
Smtp__FromEmail=no-reply@example.com
Smtp__FromName=HRM
Smtp__PickupDirectory=App_Data/Mail

# ---------------------------------------------------------------- storage
Storage__RootPath=App_Data/Storage

# ---------------------------------------------------------------- application
# Used to build password-reset links in email.
App__ClientBaseUrl=http://localhost:5173
App__CompanyName=HRM
# An SNU release this many days or fewer from an NTNS release is cancelled.
App__SnuCancellationWindowDays=7

# ---------------------------------------------------------------- limits and CORS
RateLimiting__AuthPermitLimit=10
RateLimiting__AuthWindowSeconds=60
Cors__AllowedOrigins__0=http://localhost:5173

# ---------------------------------------------------------------- frontend (HRM.Client)
# Vite dev-server proxy target when the API is not on port 5000.
VITE_API_TARGET=http://localhost:5000
